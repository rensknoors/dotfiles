{
  "files.associations": {
    "*.config": "xml",
  },
  "editor.wordWrap": "on",
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "[javascript]": {},
  "editor.cursorBlinking": "phase",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.minimap.renderCharacters": false,
  "breadcrumbs.enabled": true,
  "editor.suggestSelection": "first",
  "css.validate": false,
  "less.validate": false,
  "scss.validate": false,
  "gitlens.advanced.messages": {
    "suppressGitMissingWarning": true,
  },
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "path": "C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [],
    },
  },
  "editor.bracketPairColorization.enabled": true,
  "explorer.confirmDragAndDrop": false,
  "git.confirmSync": false,
  "editor.renderWhitespace": "all",
  "editor.detectIndentation": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
  },
  "security.workspace.trust.untrustedFiles": "open",
  "editor.inlineSuggest.enabled": true,
  "typescript.tsserver.log": "verbose",
  "git.autofetch": "all",
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "[svg]": {},
  "editor.formatOnSave": true,
  "svg.preview.mode": "svg",
  "terminal.integrated.fontFamily": "'FiraMono Nerd Font Mono', Consolas, 'Courier New', monospace",
  "terminal.integrated.localEchoStyle": "dim",
  "debug.console.fontFamily": "'FiraMono Nerd Font'",
  "editor.fontFamily": "'FiraMono Nerd Font Mono', Menlo, Monaco, 'Courier New', monospace",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.indentSize": 2,
  "symbols.hidesExplorerArrows": false,
  "redhat.telemetry.enabled": false,
  "window.zoomLevel": 1,
  "dotnet.defaultSolution": "/usr/local/share/dotnet/dotnet",
  "editor.pasteAs.preferences": [
    "text.updateImports.jsts"
  ],
  "cursor.cpp.disabledLanguages": [
    "yaml",
    "markdown"
  ],
  "cursor.composer.renderPillsInsteadOfBlocks": true,
  "gitlens.launchpad.indicator.enabled": false,
  "workbench.iconTheme": "symbols",
  "workbench.colorTheme": "Monospace Dark",
  "workbench.sideBar.location": "right",
  "gitlens.ai.model": "openai:gpt-4o",
  "editor.minimap.enabled": true,
  "editor.minimap.autohide": true,
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "cursor.composer.shouldAllowCustomModes": true,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "cursor.inlineDiff.mode": "unified",
  "gitlens.rebaseEditor.openOnPausedRebase": true,
  "workbench.editorAssociations": {
    "git-rebase-todo": "default",
    "*.svg": "default"
  },
  "remote.SSH.remotePlatform": {
    "elliot@192.168.86.92": "linux",
    "7b22686f73744e616d65223a22656c6c696f74403139322e3136382e38362e3932227d": "linux",
    "192.168.86.92": "linux",
    "elliot": "linux",
    "home": "linux"
  },
  "window.autoDetectColorScheme": false,
  "workbench.settings.applyToAllProfiles": [
    "editor.fontSize"
  ],
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "js/ts.experimental.useTsgo": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "cursor.composer.queueMessageDefaultBehavior": "steer",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferences.includePackageJsonAutoImports": "auto",
  "gitlens.gitCommands.skipConfirmations": [
    "fetch:command",
    "stash-push:command",
    "pull:command"
  ],
}
